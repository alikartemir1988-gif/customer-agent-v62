# Required for production
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-service.example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-secret
DASHBOARD_SESSION_SECRET=replace-with-an-independent-long-random-secret

# Optional Gemini answers to open Telegram questions. Store the key in Render,
# not Git. Without a key, the existing local replies continue to work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Enable only for deployment QA; logs three fixed synthetic questions/answers.
GEMINI_RUN_SMOKE_TESTS=false

# Optional Botpress lab/customer-service adapter. Use a new secret that is not
# shared with Telegram, Meta, or administration access.
BOTPRESS_INTEGRATION_SECRET=

# Optional Langfuse observability. Tracing stays disabled unless all three
# connection values are configured. Customer message content is redacted by
# default; only enable capture for synthetic or consented test conversations.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_CAPTURE_CONTENT=false

# Persistent PostgreSQL is recommended in production.
DATABASE_URL=
PGPASSWORD=
DB_PATH=customer_agent.db
PORT=8000
DASHBOARD_PORT=10001

# Portable container settings. Keep webhook registration disabled while staging.
APP_SERVICE=core
APP_GIT_COMMIT=
TELEGRAM_REGISTER_WEBHOOK_ON_START=false
DEMO_COOKIE_SECURE=true
DEMO_SESSION_SECRET=

# Optional merchant configuration; JSON must be on one line.
# PRODUCTS_JSON={"الجهاز":{"price":30,"currency":"$","available":true,"aliases":["جهاز"],"colors":["أسود","أبيض"],"payment_methods":["الدفع عند الاستلام"]}}
# DELIVERY_JSON={"دمشق":"3-5 أيام"}

# Optional Facebook Messenger channel
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
