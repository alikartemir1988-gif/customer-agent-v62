# Required for Telegram deployment
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-service.example.com

# Generate long random values. Never commit real secrets.
ADMIN_API_KEY=replace-with-a-long-random-secret
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Runtime
PORT=10000
DB_PATH=customer_agent.db

