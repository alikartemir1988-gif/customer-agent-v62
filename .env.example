# Required for production
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-service.example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-secret
DASHBOARD_SESSION_SECRET=replace-with-an-independent-long-random-secret

# Persistent PostgreSQL is recommended in production.
DATABASE_URL=
DB_PATH=customer_agent.db
PORT=8000
DASHBOARD_PORT=10001

# Optional merchant configuration; JSON must be on one line.
# PRODUCTS_JSON={"الجهاز":{"price":30,"currency":"$","available":true,"aliases":["جهاز"],"colors":["أسود","أبيض"],"payment_methods":["الدفع عند الاستلام"]}}
# DELIVERY_JSON={"دمشق":"3-5 أيام"}

# Optional Facebook Messenger channel
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
