# Required for Customer Agent V6 production (app.py / dashboard.py).
# The Majd sales service reads its own MAJD_* settings in the section below.
TELEGRAM_BOT_TOKEN=
WEBHOOK_URL=https://your-service.example.com
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-secret
DASHBOARD_SESSION_SECRET=replace-with-an-independent-long-random-secret

# Majd sales bot (majd_sales_bot.py)
# Required: /health returns 503 unless all three settings are configured.
# MAJD_WEBHOOK_URL is the public base URL; Majd appends /majd/webhook.
MAJD_TELEGRAM_BOT_TOKEN=
MAJD_WEBHOOK_URL=https://your-majd-service.example.com
MAJD_WEBHOOK_SECRET=

# Optional: enables POST /admin/setup-webhook with the X-Admin-Key header.
# Automatic webhook setup at startup does not require this admin key.
MAJD_ADMIN_API_KEY=

# Optional for startup, required to send customer lead notifications to the owner.
MAJD_OWNER_CHAT_ID=
# Optional owner contact text shown to customers.
OWNER_CONTACT=
# Optional demo link override; this is the service's default public demo URL.
V6_DEMO_URL=https://customer-agent-v6-demo.onrender.com

# Optional Gemini replies; without a key, Majd uses local scripted replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional synthetic Gemini checks at startup; disabled by default.
MAJD_RUN_GEMINI_SMOKE_TESTS=false

# Optional Botpress lab/customer-service adapter. Use a new secret that is not
# shared with Telegram, Meta, or administration access.
BOTPRESS_INTEGRATION_SECRET=

# Optional Langfuse observability. Tracing stays disabled unless all three
# connection values are configured. Customer message content is redacted by
# default; only enable capture for synthetic or consented test conversations.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_CAPTURE_CONTENT=false

# Persistent PostgreSQL is recommended in production.
# Shared with Majd: optional there, used to persist its message history.
DATABASE_URL=
DB_PATH=customer_agent.db
PORT=8000
DASHBOARD_PORT=10001

# Optional merchant configuration; JSON must be on one line.
# PRODUCTS_JSON={"الجهاز":{"price":30,"currency":"$","available":true,"aliases":["جهاز"],"colors":["أسود","أبيض"],"payment_methods":["الدفع عند الاستلام"]}}
# DELIVERY_JSON={"دمشق":"3-5 أيام"}

# Optional Facebook Messenger channel
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
